
{
  "entities": {
    "UserProfile": {
      "title": "ملف المستخدم",
      "description": "بيانات المستخدم الأساسية وصلاحياته وتقدمه الدراسي واشتراكاته وتقييد الأجهزة",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "admin"] },
        "status": { "type": "string", "enum": ["active", "banned"] },
        "forcePasswordChange": { "type": "boolean" },
        "lastSessionId": { "type": "string" },
        "deviceIds": { "type": "array", "items": { "type": "string" } },
        "showInLeaderboard": { "type": "boolean" },
        "enrolledCourses": { "type": "array", "items": { "type": "string" } },
        "progress": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "CertificateClaim": {
      "title": "طلب بيانات شهادة",
      "description": "الأسماء الرباعية والعناوين التي يدخلها الطالب لإصدار الشهادات",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "courseId": { "type": "string" },
        "courseTitle": { "type": "string" },
        "nameAr": { "type": "string", "description": "الاسم الرباعي بالعربي" },
        "nameEn": { "type": "string", "description": "الاسم الرباعي بالإنجليزي" },
        "address": { "type": "string", "description": "عنوان الاستلام بالتفصيل" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Course": {
      "title": "الدورة التدريبية",
      "description": "بيانات الدورة الأساسية ومحتواها",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "instructor": { "type": "string" },
        "instructorId": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string" },
        "videosCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Instructor": {
      "title": "المدرب",
      "description": "بيانات المدرب وخبراته وحساباته",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "accreditation": { "type": "string" },
        "bio": { "type": "string" },
        "photoURL": { "type": "string" },
        "specialty": { "type": "string" },
        "rating": { "type": "number" },
        "qualifications": { "type": "string" },
        "socials": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "specialty"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "بيانات الطلاب والمديرين"
    },
    "/certificate_claims/{claimId}": {
      "schema": "CertificateClaim",
      "description": "سجلات الأسماء والعناوين لإصدار الشهادات"
    },
    "/instructors/{instructorId}": {
      "schema": "Instructor",
      "description": "قائمة المدربين المعتمدين في المنصة"
    },
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "قائمة الدورات التدريبية"
    }
  }
}
