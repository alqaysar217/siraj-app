
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- وظائف الحماية الأساسية ---
    
    function isLoggedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // التأكد من أن المستخدم مسجل قبل محاولة جلب بياناته لمنع انهيار القاعدة للزوار
      return isLoggedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- قواعد مجموعات المستخدمين ---

    match /users/{userId} {
      // 1. القراءة العامة: مسموح لأي شخص (زائر أو مسجل) رؤية الطلاب الذين وافقوا على الظهور
      // هذا الشرط مستقل تماماً لضمان عمل قائمة المتصدرين للجميع
      allow get, list: if resource.data.showInLeaderboard == true;
      
      // 2. القراءة الخاصة: صاحب الحساب أو المدير يقرأ الملف كاملاً (بما في ذلك الحقول السرية)
      allow read: if isLoggedIn() && (request.auth.uid == userId || isAdmin());
      
      // 3. إنشاء الحساب: مسموح للمسجلين الجدد بإنشاء ملفهم الخاص
      allow create: if isLoggedIn() && request.auth.uid == userId 
                    && request.resource.data.role == 'student'
                    && request.resource.data.status == 'active'
                    && request.resource.data.enrolledCourses.size() == 0;
      
      // 4. التحديث: منع الطلاب من تعديل الحقول الحساسة
      allow update: if isAdmin() 
                  || (isLoggedIn() && request.auth.uid == userId 
                      && !(request.resource.data.diff(resource.data).affectedKeys()
                      .hasAny(['role', 'enrolledCourses', 'deviceIds', 'points', 'status', 'email', 'progress'])));
      
      // 5. الحذف: للمدير فقط (لحماية سجلات الاشتراكات)
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();

      match /lessons/{lessonId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /books/{bookId} {
      allow read: if true;
      allow write: if isAdmin();

      match /chapters/{chapterId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /certificates/{certId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /instructors/{instructorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      // السماح بكتابة مراجعة فقط إذا كان الشخص هو صاحب الهوية الحقيقية ومشترك في الدورة
      allow create: if isLoggedIn() 
                    && request.resource.data.userId == request.auth.uid
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.enrolledCourses.hasAny([request.resource.data.courseId]);
      
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /bankAccounts/{accountId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subscriptions/{subId} {
      allow read: if isAdmin() || (isLoggedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin();
    }

    match /trash/{trashId} {
      allow read, write: if isAdmin();
    }

    match /socialLinks/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
