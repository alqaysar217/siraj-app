
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- وظائف الحماية الأساسية ---
    
    function isLoggedIn() {
      return request.auth != null;
    }

    // فحص الرتبة بشكل مباشر لتجنب الدوران (Recursion)
    function isAdmin() {
      return isLoggedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- قواعد مجموعات المستخدمين ---

    match /users/{userId} {
      // السماح للقراءة: الشخص لنفسه، أو إذا كان مديراً، أو إذا كان الطالب وافق على الظهور في لوحة المتصدرين
      allow read: if isLoggedIn() && (
        request.auth.uid == userId || 
        isAdmin() ||
        resource.data.get('showInLeaderboard', false) == true
      );
      
      // إنشاء الحساب: مسموح للمسجلين الجدد بإنشاء ملفهم الخاص
      allow create: if isLoggedIn() && request.auth.uid == userId;
      
      // التحديث النهائي: يسمح للطالب بتحديث بياناته (نقاط، تقدم، هاتف، صورة) 
      // ويمنعه فقط من تغيير (الرتبة، الحالة، البريد، وقائمة الدورات الأصلية) لضمان الأمان المالي
      allow update: if isLoggedIn() && (
        (request.auth.uid == userId && 
         request.resource.data.role == resource.data.role && 
         request.resource.data.status == resource.data.status &&
         request.resource.data.email == resource.data.email &&
         request.resource.data.enrolledCourses == resource.data.enrolledCourses)
        || isAdmin()
      );
      
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();

      match /lessons/{lessonId} {
        allow read: if true;
        allow write: if isAdmin();
      }
      
      match /chapters/{chapterId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /books/{bookId} {
      allow read: if true;
      allow write: if isAdmin();

      match /chapters/{chapterId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /certificates/{certId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /instructors/{instructorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isLoggedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /bankAccounts/{accountId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subscriptions/{subId} {
      allow read: if isAdmin() || (isLoggedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin();
    }

    match /trash/{trashId} {
      allow read, write: if isAdmin();
    }

    match /socialLinks/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
