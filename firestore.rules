
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- وظائف الحماية الأساسية ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- قواعد المجموعات ---

    match /users/{userId} {
      // السماح بالقراءة (get/list) للجميع إذا كان الحساب عاماً (للوحة المتصدرين)
      // أو إذا كان المستخدم هو المدير أو صاحب الحساب
      allow read: if (resource.data.showInLeaderboard == true) 
                  || (isAuthenticated() && (request.auth.uid == userId || isAdmin()));
      
      // تأمين إنشاء الحساب: يجب أن يسجل كطالب وبدون دورات مسبقة
      allow create: if isAuthenticated() && request.auth.uid == userId 
                    && request.resource.data.role == 'student'
                    && request.resource.data.enrolledCourses.size() == 0;
      
      // تأمين التحديث: منع الطالب من تعديل رتبته أو أجهزته أو اشتراكاته
      allow update: if isAdmin() 
                  || (isAuthenticated() && request.auth.uid == userId 
                      && !(request.resource.data.diff(resource.data).affectedKeys()
                      .hasAny(['role', 'enrolledCourses', 'deviceIds', 'points', 'status'])));
      
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();

      match /lessons/{lessonId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /books/{bookId} {
      allow read: if true;
      allow write: if isAdmin();

      match /chapters/{chapterId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /certificates/{certId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /instructors/{instructorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      // التحقق من أن المراجع هو صاحب الحساب الحقيقي ومشترك فعلي في الدورة
      allow create: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.enrolledCourses.hasAny([request.resource.data.courseId]);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /bankAccounts/{accountId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subscriptions/{subId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin();
    }

    match /trash/{trashId} {
      allow read, write: if isAdmin();
    }

    match /socialLinks/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
