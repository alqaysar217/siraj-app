
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- وظائف الحماية الأساسية ---
    
    function isLoggedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // التحقق من أن المستخدم مسجل أولاً لمنع أخطاء القواعد
      return isLoggedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- قواعد المجموعات ---

    match /users/{userId} {
      // 1. القراءة العامة: للوحة المتصدرين (متاحة للجميع: زوار ومسجلين)
      // ملاحظة: يجب أن يحتوي الاستعلام على فلتر (showInLeaderboard == true)
      allow read: if resource.data.showInLeaderboard == true;
      
      // 2. القراءة الخاصة: صاحب الحساب أو المدير يقرأ الملف كاملاً
      allow read: if isLoggedIn() && (request.auth.uid == userId || isAdmin());
      
      // 3. إنشاء الحساب: حماية ضد ثغرة المدير المتخفي
      allow create: if isLoggedIn() && request.auth.uid == userId 
                    && request.resource.data.role == 'student'
                    && request.resource.data.status == 'active'
                    && request.resource.data.enrolledCourses.size() == 0;
      
      // 4. التحديث: منع الطالب من تعديل الحقول الحساسة (الأمان والمالية)
      allow update: if isAdmin() 
                  || (isLoggedIn() && request.auth.uid == userId 
                      && !(request.resource.data.diff(resource.data).affectedKeys()
                      .hasAny(['role', 'enrolledCourses', 'deviceIds', 'points', 'status', 'email'])));
      
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();

      match /lessons/{lessonId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /books/{bookId} {
      allow read: if true;
      allow write: if isAdmin();

      match /chapters/{chapterId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /certificates/{certId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /instructors/{instructorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      // منع انتحال الهوية: يجب أن يطابق الـ userId معرف الشخص المسجل حالياً
      // ويجب أن يكون الطالب مشتركاً فعلياً في الدورة ليسمح له بالتقييم
      allow create: if isLoggedIn() 
                    && request.resource.data.userId == request.auth.uid
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.enrolledCourses.hasAny([request.resource.data.courseId]);
      
      // المراجعات لا تعدل لضمان المصداقية، تحذف فقط بواسطة المدير
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /bankAccounts/{accountId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subscriptions/{subId} {
      allow read: if isAdmin() || (isLoggedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin();
    }

    match /trash/{trashId} {
      allow read, write: if isAdmin();
    }

    match /socialLinks/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
