
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- وظائف الحماية المتقدمة ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    // فحص صحة بيانات المستخدم الجديد عند التسجيل
    function isValidNewUser() {
      let data = request.resource.data;
      return data.role == 'student' 
        && data.status == 'active' 
        && data.enrolledCourses is list
        && data.enrolledCourses.size() == 0 
        && data.uid == request.auth.uid;
    }

    // منع الطالب من تعديل الحقول الحساسة
    function isNotModifyingSensitiveFields() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let sensitiveFields = [
        'role', 'status', 'enrolledCourses', 'progress', 
        'enrollmentDetails', 'uid', 'email', 'deviceIds', 'createdAt', 'points'
      ];
      return !affectedKeys.hasAny(sensitiveFields);
    }

    // فحص صحة المراجعة: يجب أن يكون صاحب الحساب الحقيقي ومشتركاً
    function isValidReview() {
      let data = request.resource.data;
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return data.userId == request.auth.uid
        && data.rating is number
        && data.rating >= 1 && data.rating <= 5
        && user.enrolledCourses.hasAny([data.courseId]);
    }

    // --- القواعد المخصصة للمجموعات ---

    match /users/{userId} {
      // السماح للقراءة (get/list) إذا كان الحساب عاماً للجميع (للتحفيز) 
      // أو إذا كان الشخص مديراً أو صاحب الحساب
      // تم تقديم شرط showInLeaderboard لضمان عمل الـ list للزوار
      allow read: if (resource.data.showInLeaderboard == true) 
                  || isAdmin() 
                  || (isAuthenticated() && request.auth.uid == userId);
      
      allow create: if isAuthenticated() && request.auth.uid == userId && isValidNewUser();
      
      allow update: if isAdmin() 
                  || (isAuthenticated() && request.auth.uid == userId && isNotModifyingSensitiveFields());
      
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();

      match /lessons/{lessonId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /books/{bookId} {
      allow read: if true;
      allow write: if isAdmin();

      match /chapters/{chapterId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /certificates/{certId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /instructors/{instructorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidReview();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /bankAccounts/{accountId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subscriptions/{subId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin();
    }

    match /trash/{trashId} {
      allow read, write: if isAdmin();
    }

    match /socialLinks/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
