
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // دالة محسنة للتحقق من الصلاحيات دون التسبب في تكرار لانهائي
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      // السماح للقراءة إذا كان المستخدم هو صاحب الحساب، أو إذا كان الملف معد للعرض العام، أو إذا كان الطلب من آدمن
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || 
        resource.data.showInLeaderboard == true ||
        isAdmin()
      );
      // السماح للمستخدم بإنشاء ملفه الشخصي عند التسجيل
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // السماح بالتحديث لصاحب الحساب أو الآدمن
      allow update: if isAuthenticated() && (
        request.auth.uid == userId || 
        isAdmin()
      );
      // الحذف للآدمن فقط
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
      
      match /lessons/{lessonId} {
        allow read: if true;
        allow write: if isAdmin();
      }
      match /batches/{batchId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /whatsapp_grades/{docId} {
      allow read, write: if isAdmin();
    }

    match /instructors/{instructorId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    match /subscriptions/{subId} { allow read, write: if isAdmin(); }
    match /bankAccounts/{accountId} { allow read: if true; allow write: if isAdmin(); }
    match /books/{bookId} { 
      allow read: if true; 
      allow write: if isAdmin();
      match /chapters/{chapterId} {
        allow read: if true; 
        allow write: if isAdmin();
      }
    }
    match /socialLinks/{linkId} { allow read: if true; allow write: if isAdmin(); }
    match /trash/{trashId} { allow read, write: if isAdmin(); }
    match /certificates/{certId} { allow read: if true; allow write: if isAdmin(); }
  }
}
