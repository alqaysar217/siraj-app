
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- وظائف الحماية الأساسية ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // جلب بيانات المستخدم من قاعدة البيانات للتحقق من دوره
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    // التحقق من سلامة البيانات عند إنشاء حساب جديد (منع التلاعب بالرتبة أو الدورات)
    function isValidNewUser() {
      let data = request.resource.data;
      return data.role == 'student' 
        && data.status == 'active' 
        && data.enrolledCourses.size() == 0 
        && data.uid == request.auth.uid;
    }

    // التحقق من أن المستخدم لم يغير الحقول الحساسة أثناء التحديث
    function isNotModifyingSensitiveFields() {
      let sensitiveFields = ['role', 'status', 'enrolledCourses', 'progress', 'enrollmentDetails', 'uid', 'email'];
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(sensitiveFields);
    }

    // --- القواعد المخصصة للمجموعات ---

    match /users/{userId} {
      // القراءة: المدير يرى الكل، المسجل يرى نفسه. 
      // لوحة الشرف: تسمح فقط للمسجلين برؤية من وافق على الظهور، مع حماية البيانات الحساسة.
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId) || (isAuthenticated() && resource.data.showInLeaderboard == true);
      
      // الإنشاء: يجب أن يكون المستخدم مسجلاً وأن يلتزم بشروط "المستخدم الجديد الصالح"
      allow create: if isAuthenticated() && request.auth.uid == userId && isValidNewUser();
      
      // التحديث: المدير يعدل كل شيء، الطالب يعدل فقط بياناته غير الحساسة
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId && isNotModifyingSensitiveFields());
      
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();

      match /lessons/{lessonId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /books/{bookId} {
      allow read: if true;
      allow write: if isAdmin();

      match /chapters/{chapterId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /certificates/{certId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /instructors/{instructorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      // لا يسمح بكتابة مراجعة إلا للمشتركين فعلياً، ويجب أن يكتبها المستخدم بهويته الحقيقية فقط
      allow create: if isAuthenticated() 
        && getUserData().enrolledCourses.hasAny([request.resource.data.courseId])
        && request.resource.data.userId == request.auth.uid;
      
      allow delete: if isAdmin();
      allow update: if isAdmin();
    }

    match /bankAccounts/{accountId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subscriptions/{subId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }

    match /trash/{trashId} {
      allow read, write: if isAdmin();
    }

    match /socialLinks/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
