
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- وظائف الحماية الأساسية ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // جلب بيانات المستخدم من قاعدة البيانات للتحقق من دوره
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    // التحقق من أن المستخدم لم يغير الحقول الحساسة
    function isNotModifyingSensitiveFields() {
      let sensitiveFields = ['role', 'status', 'enrolledCourses', 'progress', 'enrollmentDetails', 'uid', 'email'];
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(sensitiveFields);
    }

    // --- القواعد المخصصة للمجموعات ---

    match /users/{userId} {
      // القراءة: المدير يرى الكل، المسجل يرى نفسه، والزوار يرون فقط الاسم والنقاط (للوحة الشرف)
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId) || (resource != null && resource.data.showInLeaderboard == true);
      
      // الإنشاء: فقط عند التسجيل الأول
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      // التحديث: المدير يعدل كل شيء، الطالب يعدل فقط بياناته غير الحساسة
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId && isNotModifyingSensitiveFields());
      
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();

      match /lessons/{lessonId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /books/{bookId} {
      allow read: if true;
      allow write: if isAdmin();

      match /chapters/{chapterId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /certificates/{certId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /instructors/{instructorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      // لا يسمح بكتابة مراجعة إلا للمشتركين فعلياً في الدورة (إجراء إضافي للأمان)
      allow create: if isAuthenticated() && getUserData().enrolledCourses.hasAny([request.resource.data.courseId]);
      allow delete: if isAdmin();
      allow update: if isAdmin();
    }

    match /bankAccounts/{accountId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subscriptions/{subId} {
      allow read: if isAdmin();
      allow create: if isAdmin(); // تفعيل الاشتراك حصراً من جهة المدير
    }

    match /trash/{trashId} {
      allow read, write: if isAdmin();
    }

    match /socialLinks/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
