
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- وظائف الحماية الأساسية ---
    
    function isLoggedIn() {
      return request.auth != null;
    }

    // وظيفة للتحقق من الرتبة دون إحداث دوران في مجموعة المستخدمين
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'student');
    }

    function isAdmin() {
      return isLoggedIn() && getUserRole() == 'admin';
    }

    // --- قواعد مجموعات المستخدمين ---

    match /users/{userId} {
      // السماح للقراءة: الشخص لنفسه، أو إذا كان مديراً، أو إذا كان الطالب وافق على الظهور في لوحة المتصدرين
      allow read: if isLoggedIn() && (
        request.auth.uid == userId || 
        isAdmin() ||
        resource.data.get('showInLeaderboard', false) == true
      );
      
      // إنشاء الحساب: مسموح للمسجلين الجدد بإنشاء ملفهم الخاص برتبة طالب فقط
      allow create: if isLoggedIn() && request.auth.uid == userId 
                    && request.resource.data.get('role', 'student') == 'student';
      
      // التحديث: 
      // 1. للمدير: صلاحية كاملة
      // 2. للطالب: تعديل بياناته بشرط عدم المساس بالحقول الحساسة (الرتبة، الحالة، البريد، الدورات المشترك بها)
      allow update: if isAdmin() 
                  || (isLoggedIn() && request.auth.uid == userId 
                      && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'email', 'uid', 'enrolledCourses'])));
      
      // الحذف: للمدير فقط
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();

      match /lessons/{lessonId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /books/{bookId} {
      allow read: if true;
      allow write: if isAdmin();

      match /chapters/{chapterId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /certificates/{certId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /instructors/{instructorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isLoggedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /bankAccounts/{accountId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subscriptions/{subId} {
      allow read: if isAdmin() || (isLoggedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin();
    }

    match /trash/{trashId} {
      allow read, write: if isAdmin();
    }

    match /socialLinks/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
