
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isNotModifyingAdminFields() {
      let adminFields = ['role', 'status', 'enrolledCourses', 'uid', 'email', 'createdAt'];
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(adminFields);
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin() || resource.data.showInLeaderboard == true);
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId && isNotModifyingAdminFields());
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
      match /lessons/{lessonId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }
    
    match /reviews/{reviewId} {
      // السماح بالقراءة للجميع (بما في ذلك الزوار) لضمان عمل التبويب بشكل صحيح
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    match /subscriptions/{subId} { allow read, write: if isAdmin(); }
    match /bankAccounts/{accountId} { allow read: if true; allow write: if isAdmin(); }
    match /books/{bookId} { allow read: if true; allow write: if isAdmin(); }
    match /socialLinks/{linkId} { allow read: if true; allow write: if isAdmin(); }
    match /trash/{trashId} { allow read, write: if isAdmin(); }
    match /certificates/{certId} { allow read: if true; allow write: if isAdmin(); }
  }
}
