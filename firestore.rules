
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isAuthenticated() && (request.auth.uid == userId || resource.data.showInLeaderboard == true || isAdmin());
      allow list: if isAuthenticated() && (isAdmin() || resource.data.showInLeaderboard == true);
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Certificate Claims (New)
    match /certificate_claims/{claimId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Courses and nested subcollections
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
      
      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /instructors/{instructorId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    match /subscriptions/{subId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
    
    match /bankAccounts/{accountId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /books/{bookId} { 
      allow read: if true; 
      allow write: if isAdmin();
      match /{allSubcollections=**} {
        allow read: if true; 
        allow write: if isAdmin();
      }
    }
    
    match /socialLinks/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /trash/{trashId} {
      allow read, write: if isAdmin();
    }
    
    match /certificates/{certId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /whatsapp_grades/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
