
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- وظائف الحماية الأساسية ---
    
    function isLoggedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // تحصين الدالة لمنع الانهيار عند فحص الزوار (Guests)
      return isLoggedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- قواعد مجموعات المستخدمين ---

    match /users/{userId} {
      // السماح بالقراءة (get & list) إذا كان المستخدم وافق على الظهور في لوحة المتصدرين
      // أو إذا كان المستخدم هو صاحب الحساب أو مديراً
      allow read: if resource.data.showInLeaderboard == true 
                  || (isLoggedIn() && (request.auth.uid == userId || isAdmin()));
      
      // إنشاء الحساب: مسموح للمسجلين الجدد بإنشاء ملفهم الخاص بشروط محددة
      allow create: if isLoggedIn() && request.auth.uid == userId 
                    && request.resource.data.role == 'student'
                    && request.resource.data.status == 'active';
      
      // التحديث: منع الطلاب من تعديل الحقول الحساسة (مثل النقاط والأجهزة والاشتراكات)
      allow update: if isAdmin() 
                  || (isLoggedIn() && request.auth.uid == userId 
                      && !(request.resource.data.diff(resource.data).affectedKeys()
                      .hasAny(['role', 'enrolledCourses', 'deviceIds', 'points', 'status', 'email', 'progress'])));
      
      // الحذف: للمدير فقط
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();

      match /lessons/{lessonId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /books/{bookId} {
      allow read: if true;
      allow write: if isAdmin();

      match /chapters/{chapterId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /certificates/{certId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /instructors/{instructorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isLoggedIn() 
                    && request.resource.data.userId == request.auth.uid
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.enrolledCourses.hasAny([request.resource.data.courseId]);
      
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /bankAccounts/{accountId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subscriptions/{subId} {
      allow read: if isAdmin() || (isLoggedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin();
    }

    match /trash/{trashId} {
      allow read, write: if isAdmin();
    }

    match /socialLinks/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
