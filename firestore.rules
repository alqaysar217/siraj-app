
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- وظائف الحماية الأساسية ---
    
    function isLoggedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isLoggedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'student') == 'admin';
    }

    // --- قواعد مجموعات المستخدمين ---

    match /users/{userId} {
      // السماح للقراءة فقط للمسجلين أو المدير
      allow read: if isLoggedIn() && (
        request.auth.uid == userId || 
        isAdmin() || 
        resource.data.get('showInLeaderboard', false) == true
      );
      
      // إنشاء الحساب: مسموح للمسجلين الجدد بإنشاء ملفهم الخاص
      allow create: if isLoggedIn() && request.auth.uid == userId 
                    && request.resource.data.get('role', 'student') == 'student';
      
      // التحديث: السماح للطالب بتحديث النقاط، التقدم، الإعدادات الشخصية، وصورة الملف
      // الحقول الممنوع تعديلها نهائياً هي الرتبة (role)، الحالة (status)، والبريد (email)
      allow update: if isAdmin() 
                  || (isLoggedIn() && request.auth.uid == userId 
                      && request.resource.data.role == resource.data.role
                      && request.resource.data.status == resource.data.status
                      && request.resource.data.email == resource.data.email);
      
      // الحذف: للمدير فقط
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();

      match /lessons/{lessonId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /books/{bookId} {
      allow read: if true;
      allow write: if isAdmin();

      match /chapters/{chapterId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /certificates/{certId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /instructors/{instructorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isLoggedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /bankAccounts/{accountId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subscriptions/{subId} {
      allow read: if isAdmin() || (isLoggedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin();
    }

    match /trash/{trashId} {
      allow read, write: if isAdmin();
    }

    match /socialLinks/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
